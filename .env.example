PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=change-me
JWT_EXPIRES_IN=900s

# URL base del front (login e invitaciones: {DOMAIN_URL}/invitar?token=...)
DOMAIN_URL=http://localhost:5173

# Solo para desarrollo: pnpm run seed:user
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=Admin

# Resend (API HTTP vía SDK oficial `resend`). MAIL_FROM debe ser dominio verificado en Resend;
# NO uses @gmail.com ni el email del usuario aquí (ese va en replyTo automáticamente).
# Con onboarding@resend.dev solo llegan correos al email de tu cuenta Resend; para clientes reales,
# verifica tu dominio en https://resend.com/domains y usa MAIL_FROM=cotizaciones@tudominio.com
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=Cotizador
MAIL_ENABLED=true

# Digital Ocean Spaces (S3 compatible)
DO_SPACES_REGION=sfo3
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_BUCKET=cotizador-storage
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
# Base pública para URLs de objetos (origin o CDN)
DO_SPACES_PUBLIC_URL=https://cotizador-storage.sfo3.digitaloceanspaces.com
